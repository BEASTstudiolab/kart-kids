# Anthropic API key
ANTHROPIC_API_KEY=
# GitHub personal access token (required for issues tier)
GH_TOKEN=
# Operating mode: auto | supervised
MODE=auto
# Priority mode: tier-ordered (default) | cross-tier
PRIORITY_MODE=tier-ordered

# --- Task Limits ---
# Maximum total sandbox.run() invocations before halting
MAX_ITERATIONS=50
# Halt after N consecutive task failures
CIRCUIT_BREAKER_THRESHOLD=3
# Minimum iteration budget per task (skip task if less remains)
MIN_TASK_BUDGET=8
# Max estimated files an ideation idea can touch (blast radius limit)
MAX_FILES_PER_IDEA=10

# --- Phase Timeouts (seconds) ---
TIMEOUT_PLAN=900
TIMEOUT_WORK=1200
TIMEOUT_REVIEW=600

# --- Phase Iteration Limits ---
MAX_ITERATIONS_PLAN=10
MAX_ITERATIONS_WORK=100
MAX_ITERATIONS_REVIEW=10
# Max review rounds before declaring stuck
MAX_REVIEW_ROUNDS=3

# --- Operational ---
# XML parsing retry cap for discovery/plan output
MAX_XML_RETRIES=5
# Git operation timeout (milliseconds)
GIT_TIMEOUT=60000
# Minimum disk space before halting (MB)
MIN_DISK_MB=2000
